{
  "elements": [
    {
      "type": "SelectInstance",
      "name": "ArchiveControlID",
      "caption": "Archive Control (Archiv-Instanz)"
    },

    { "type": "SelectVariable", "name": "VarPV",   "caption": "PV [kWh/Intervall oder Zähler]" },
    { "type": "CheckBox",       "name": "PVIsCounter",   "caption": "PV ist Zählerstand (kumuliert)" },

    { "type": "SelectVariable", "name": "VarLoad", "caption": "Last [kWh/Intervall oder Zähler]" },
    { "type": "CheckBox",       "name": "LoadIsCounter", "caption": "Last ist Zählerstand (kumuliert)" },

    { "type": "SelectVariable", "name": "VarHPHeat", "caption": "WP Heizen [kWh/Intervall oder Zähler]" },
    { "type": "CheckBox",       "name": "HPHeatIsCounter", "caption": "WP Heizen ist Zählerstand (kumuliert)" },

    { "type": "SelectVariable", "name": "VarHPDHW", "caption": "WP Warmwasser [kWh/Intervall oder Zähler]" },
    { "type": "CheckBox",       "name": "HPDHWIsCounter", "caption": "WP Warmwasser ist Zählerstand (kumuliert)" },

    {
      "type": "Label",
      "caption": "Optional (falls es nur einen Gesamtzähler gibt):"
    },
    { "type": "SelectVariable", "name": "VarHP", "caption": "WP Gesamt [kWh/Intervall oder Zähler] (optional)" },
    { "type": "CheckBox",       "name": "HPIsCounter", "caption": "WP Gesamt ist Zählerstand (kumuliert)" },

    {
      "type": "ExpansionPanel",
      "caption": "Wärmemengenzähler (Ausgangsenergie)",
      "items": [
        {
          "type": "RowLayout",
          "items": [
            { "type": "SelectVariable", "name": "VarHeatEnergy", "caption": "Wärmemenge Heizen [kWh / Zähler]" },
            { "type": "CheckBox",       "name": "HeatEnergyIsCounter", "caption": "Heiz-Wärmemenge ist Zählerstand" }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            { "type": "SelectVariable", "name": "VarDHWEnergy",  "caption": "Wärmemenge Warmwasser [kWh / Zähler]" },
            { "type": "CheckBox",       "name": "DHW_EnergyIsCounter", "caption": "WW-Wärmemenge ist Zählerstand" }
          ]
        },
        {
          "type": "Label",
          "caption": "Hinweis: Diese Werte werden zur COP-Berechnung genutzt (COP gesamt/Heizen/WW)."
        }
      ]
    },

    { "type": "SelectVariable", "name": "VarImport", "caption": "Netzbezug [kWh/Intervall oder Zähler]" },
    { "type": "CheckBox",       "name": "ImportIsCounter", "caption": "Netzbezug ist Zählerstand (kumuliert)" },

    { "type": "SelectVariable", "name": "VarExport", "caption": "Einspeisung [kWh/Intervall oder Zähler] (optional)" },
    { "type": "CheckBox",       "name": "ExportIsCounter", "caption": "Einspeisung ist Zählerstand (kumuliert)" },

    { "type": "SelectVariable", "name": "VarSOC", "caption": "Batterie-SoC [% , optional]" },

    {
      "type": "NumberSpinner",
      "name": "StepMinutes",
      "caption": "Zielraster [Min]",
      "minimum": 1,
      "maximum": 60,
      "suffix": " min",
      "digits": 0,
      "value": 15
    },

    {
      "type": "ExpansionPanel",
      "caption": "Zeitbereich",
      "items": [
        {
          "type": "Select",
          "name": "TimeRangeMode",
          "caption": "Modus",
          "options": [
            { "caption": "Relativ (letzte X ...)", "value": "relative" },
            { "caption": "Absolut (Von/Bis)",      "value": "absolute" }
          ],
          "value": "relative"
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "NumberSpinner",
              "name": "RelAmount",
              "caption": "Anzahl",
              "minimum": 1,
              "maximum": 365,
              "value": 3
            },
            {
              "type": "Select",
              "name": "RelUnit",
              "caption": "Einheit",
              "options": [
                { "caption": "Stunden", "value": "hours" },
                { "caption": "Tage",    "value": "days"  }
              ],
              "value": "days"
            },
            {
              "type": "CheckBox",
              "name": "UseNowAsEnd",
              "caption": "Ende = Jetzt (sonst volle Minute)",
              "value": true
            }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            { "type": "SelectDateTime", "name": "FromDateTime", "caption": "Von (absolut)" },
            { "type": "SelectDateTime", "name": "ToDateTime",   "caption": "Bis (absolut)" }
          ]
        },
        {
          "type": "CheckBox",
          "name": "AlignToMinute",
          "caption": "Start/Ende auf Minutenraster runden",
          "value": true
        }
      ]
    },

    {
      "type": "ExpansionPanel",
      "caption": "Analyse-Parameter (Komfort)",
      "items": [
        {
          "type": "NumberSpinner",
          "name": "CapKWh",
          "caption": "Batteriekapazität [kWh]",
          "minimum": 0.1,
          "maximum": 200,
          "digits": 2,
          "value": 10.0
        },
        {
          "type": "NumberSpinner",
          "name": "EtaC",
          "caption": "Ladewirkungsgrad ηc",
          "minimum": 0.5,
          "maximum": 1.0,
          "digits": 2,
          "value": 0.95
        },
        {
          "type": "NumberSpinner",
          "name": "EtaD",
          "caption": "Entladewirkungsgrad ηd",
          "minimum": 0.5,
          "maximum": 1.0,
          "digits": 2,
          "value": 0.95
        },
        {
          "type": "NumberSpinner",
          "name": "ChargeKW",
          "caption": "Max. Ladeleistung [kW]",
          "minimum": 0.1,
          "maximum": 50,
          "digits": 2,
          "value": 3.0
        },
        {
          "type": "NumberSpinner",
          "name": "DischargeKW",
          "caption": "Max. Entladeleistung [kW]",
          "minimum": 0.1,
          "maximum": 50,
          "digits": 2,
          "value": 3.0
        },
        {
          "type": "CheckBox",
          "name": "ReturnDetails",
          "caption": "Intervall-Details zurückgeben",
          "value": true
        }
      ]
    },

    {
      "type": "ValidationTextBox",
      "name": "ParamsJSON",
      "caption": "Parameter (JSON, optional – überschreibt Komfortfelder)",
      "multiline": true,
      "width": "100%"
    },

    {
      "type": "ExpansionPanel",
      "caption": "Backfill – Historische Archiv-Daten schreiben",
      "items": [
        { "type": "SelectCategory", "name": "BackfillCategoryID", "caption": "Ziel-Kategorie für Backfill-Variablen" },
        {
          "type": "RowLayout",
          "items": [
            { "type": "SelectDate", "name": "BF_FromDate", "caption": "Von (inkl.)" },
            { "type": "SelectDate", "name": "BF_ToDate",   "caption": "Bis (inkl.)" }
          ]
        },
        { "type": "Label", "caption": "Analysefenster automatisch: D–1 00:00 → D+1 00:00" },
        { "type": "Button", "caption": "Backfill jetzt starten" ,"onClick": "DEFA_BackfillRange($id);" },
        { "type": "Label", "name": "BackfillLog", "caption": "" }
      ]}
  ],

  "actions": [
    {
      "type": "PopupButton",
      "caption": "Hilfe / README (Popup)",
      "onClick": "DEFA_ShowHelp($id);",
      "popup": {
        "caption": "Modulhilfe",
        "closeCaption": "Schließen",
        "items": [
          { "type": "Label", "name": "HelpHtml", "caption": "README wird geladen..." }
        ]
      }
    },
    {
      "type": "Button",
      "caption": "Hilfe im Browser (HTML)",
      "onClick": "DEFA_OpenHelp($id);"
    },
    {
      "type": "Button",
      "caption": "Analyse jetzt",
      "onClick": "DEFA_Analyze($id);"
    },
    {
      "type": "Button",
      "caption": "Details als CSV exportieren",
      "onClick": "DEFA_ExportDetails($id);"
    }
  ]}
